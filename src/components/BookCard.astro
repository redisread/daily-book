---
import type { Book } from "../data/books";

interface Props {
  book: Book;
}

const { book } = Astro.props;
---

<div class="hero-card" data-book-id={book.id}>
  <div class="hero-content">
    <div class="book-cover-section">
      <div class="book-cover" id="bookCover">
        <div class="book-cover-placeholder">
          <div class="cover-title" set:text={book.coverTitle} />
          <div class="cover-divider"></div>
          <div class="cover-author">{book.coverAuthor}</div>
        </div>
      </div>
      <!-- Cover Lightbox -->
      <div class="cover-lightbox" id="coverLightbox" role="dialog" aria-modal="true" aria-label="封面大图">
        <div class="lightbox-backdrop"></div>
        <div class="lightbox-content">
          <div class="book-cover enlarged" id="enlargedCover">
            <div class="book-cover-placeholder">
              <div class="cover-title" set:text={book.coverTitle} />
              <div class="cover-divider"></div>
              <div class="cover-author">{book.coverAuthor}</div>
            </div>
          </div>
          <button class="lightbox-close" id="lightboxClose" aria-label="关闭">✕</button>
        </div>
      </div>
    </div>
    <div class="book-info-section">
      <div class="book-category">{book.category}</div>
      <h1 class="book-title">{book.title}</h1>
      <p class="book-author"><span>{book.author}</span></p>
      <p class="book-desc">{book.desc}</p>
      {book.editorNote && (
        <aside class="editor-note" aria-label="编辑的话">
          <div class="editor-note-label">—— 编辑的话</div>
          <p class="editor-note-text">{book.editorNote}</p>
        </aside>
      )}
      <div class="book-meta-inline">
        <span>{book.year}</span>
        <span class="meta-dot">·</span>
        <span>{book.pages}页</span>
        <span class="meta-dot">·</span>
        <span>评分 {book.rating}</span>
      </div>
      <div class="book-actions">
        <button class="btn-primary" data-action="markRead" data-book-id={book.id}>标记已读</button>
        <button class="btn-secondary" data-action="favorite" data-book-id={book.id}>♡ 收藏</button>
        <button class="btn-secondary" data-action="want" data-book-id={book.id}>☆ 想读</button>
        <a href="/rss.xml" class="btn-rss" target="_blank">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><circle cx="6.18" cy="17.82" r="2.18"/><path d="M4 4.44v2.83c7.03 0 12.73 5.7 12.73 12.73h2.83c0-8.59-6.97-15.56-15.56-15.56zm0 5.66v2.83c3.9 0 7.07 3.17 7.07 7.07h2.83c0-5.47-4.43-9.9-9.9-9.9z"/></svg>
          RSS
        </a>
      </div>
    </div>
  </div>
</div>

<script>
  import { initLightbox } from "../scripts/lightbox";
  import { initBookActions } from "../scripts/storage";

  // 从 DOM 获取 bookId + bookTitle（不再依赖 define:vars）
  // P0-0: data-book-id 取代 data-book-title，BookCard 不再以 title 做存储 key。
  const heroCard = document.querySelector('.hero-card');
  const bookId = heroCard?.getAttribute('data-book-id') ?? '';
  const bookTitle = heroCard?.querySelector('.book-title')?.textContent?.trim() ?? '';

  initLightbox();
  if (bookId) initBookActions(bookId, bookTitle);
</script>
