---
import type { Book } from "../data/books";

interface Props {
  book: Book;
}

const { book } = Astro.props;
const quotes = book.quotes;

// P0-3: DOM 只放 data-quote-id (轻量)，snapshot 5 字段走 window.__quotesRegistry inline dump
const quotesRegistry = Object.fromEntries(
  quotes.map((q, index) => [`${book.id}:${index}`, {
    quoteId: `${book.id}:${index}`,
    quoteText: q.text,
    bookId: book.id,
    bookTitle: book.title,
    bookAuthor: book.author,
    publishedDate: book.publishedDate ?? "",
  }])
);
---

<!-- P0-3: 首屏 inline script 一次性 dump 当前书的 quote registry
     多本书通过 Object.assign 合并到 window.__quotesRegistry（其他 QuoteCard 追加即可） -->
<script is:inline set:html={`
window.__quotesRegistry = window.__quotesRegistry || {};
Object.assign(window.__quotesRegistry, ${JSON.stringify(quotesRegistry)});
`} />

<!-- Desktop: vertical quotes list -->
<div class="quote-list-desktop">
  {quotes.map((q, index) => (
    <div class="quote-card stacked" data-index={index}>
      <div class="quote-mark">&ldquo;</div>
      <p class="quote-text">{q.text}</p>
      <div class="quote-source">
        ——{book.author}《{book.title}》{q.page}
      </div>
      <div class="quote-actions">
        <button class="quote-action-btn like-btn" data-index={index} data-quote-id={`${book.id}:${index}`} title="喜欢">♡</button>
        <button class="quote-action-btn share-btn" data-quote={q.text} data-source={`——${book.author}《${book.title}》${q.page}`} title="分享">⎘</button>
        <button class="quote-action-btn image-btn" data-quote={q.text} data-source={`——${book.author}《${book.title}》${q.page}`} title="生成图片">图</button>
      </div>
    </div>
  ))}
</div>

<!-- Mobile: Swipe carousel -->
<div class="quote-swipe-container" id="quoteSwipeContainer">
  <div class="quote-swipe-track" id="quoteSwipeTrack">
    {quotes.map((q, index) => (
      <div class="quote-card" data-index={index}>
        <div class="quote-mark">&ldquo;</div>
        <p class="quote-text">{q.text}</p>
        <div class="quote-source">
          ——{book.author}《{book.title}》{q.page}
        </div>
        <div class="quote-actions">
          <button class="quote-action-btn like-btn" data-index={index} data-quote-id={`${book.id}:${index}`} title="喜欢">♡</button>
          <button class="quote-action-btn share-btn" data-index={index} data-quote={q.text} data-source={`——${book.author}《${book.title}》${q.page}`} title="分享">⎘</button>
          <button class="quote-action-btn image-btn" data-index={index} data-quote={q.text} data-source={`——${book.author}《${book.title}》${q.page}`} title="生成图片">图</button>
        </div>
      </div>
    ))}
  </div>
  <div class="quote-swipe-dots" id="quoteSwipeDots"></div>
  <div class="quote-swipe-hint">← 左右滑动切换金句 →</div>
</div>

<!-- Share Image Modal -->
<div class="share-modal" id="shareModal" role="dialog" aria-modal="true" aria-label="生成分享图">
  <div class="share-modal-backdrop"></div>
  <div class="share-modal-content">
    <button class="share-modal-close" id="shareModalClose">✕</button>
    <div class="share-preview" id="sharePreview">
      <p class="share-preview-quote" id="sharePreviewQuote"></p>
      <p class="share-preview-source" id="sharePreviewSource"></p>
    </div>
    <div class="share-actions">
      <button class="share-btn share-btn-primary" id="downloadShareImage">下载图片</button>
      <button class="share-btn share-btn-secondary" id="copyShareText">复制文字</button>
    </div>
  </div>
</div>


<script>
  import { initQuoteSwipe, initQuoteActions } from "../scripts/quote-swipe";

  initQuoteSwipe();
  initQuoteActions();
</script>